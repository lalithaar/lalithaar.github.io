---
import 'remark-github-alerts/styles/github-base.css';
import 'remark-github-alerts/styles/github-colors-light.css';
import 'remark-github-alerts/styles/github-colors-dark-media.css';

interface Props {
	title?: string;
	description?: string;
	frontmatter?: { title?: string; description?: string };
}

const props = Astro.props;
const title = props.title ?? props.frontmatter?.title ?? 'Lalitha A R';
const description =
	props.description ??
	props.frontmatter?.description ??
	'Lalitha A R — researcher at the Interdisciplinary Systems Research Lab (iSRL), BS Data Science student at IIT Madras. I find the exact interaction costing your product activation, retention, or support hours, then fix it.';


---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		{props.frontmatter ? (
			<div class="md-content">
				<header class="md-header">
					<a class="wordmark" href="/">Lalitha A R</a>

				</header>
				<slot />
			</div>
		) : (
			<slot />
		)}
	</body>

<style>
    :root {
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  color-scheme: light dark;
}

body {
  background-color: Canvas;
  color: CanvasText;


  max-width: 70ch;
  margin: 0 auto;
  padding: 2rem 1.25rem;
  line-height: 1.5;
}

header {
    font-size: 1.2rem;
    margin-bottom: 2.5rem;
    opacity: 0.7;
    > a {
        text-decoration: none;
        color: CanvasText;
        font-weight: 600;
    }
}

@media (prefers-color-scheme: dark) {
  body {
    background-color: #121212; 
    
    color: #e0e0e0; 
  }
}


p {
  margin-top: 0;
  margin-bottom: 1.25rem;

}


:global(blockquote) {
  margin: 1.5rem 0;
  padding-left: 1rem;
  border-left: 2px solid currentColor;
  opacity: 0.8;
  font-style: italic; /* optional */
}

:global(blockquote > p) {
  margin: 0;
}

:global(hr) {
  border: none;
  border-top: 1px solid currentColor;
  opacity: 0.2;
  margin: 2rem 0;
}


</style>

</html>