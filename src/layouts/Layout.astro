---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Lalitha A R',
	description = 'Lalitha A R — researcher at the Interdisciplinary Systems Research Lab (iSRL), BS Data Science student at IIT Madras. I find the exact interaction costing your product activation, retention, or support hours, then fix it.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #faf5ec;
		--paper: #fffdf8;
		--ink: #35291f;
		--muted: #7d6e5b;
		--accent: #94401a;
		--accent-soft: #e7cdb9;
		--sage: #677654;
		--border: #e9dfcd;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	* {
		box-sizing: border-box;
	}

	body {
		background: var(--bg);
		color: var(--ink);
		font-family: 'Iowan Old Style', 'Palatino Linotype', Georgia, 'Noto Serif', serif;
		line-height: 1.6;
	}

	a {
		color: inherit;
	}
</style>
