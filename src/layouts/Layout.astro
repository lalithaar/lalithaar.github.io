---
interface Props {
	title?: string;
	description?: string;
	frontmatter?: { title?: string; description?: string; jsonLd?: string };
}

const props = Astro.props;
const title = props.title ?? props.frontmatter?.title ?? 'Lalitha A R';
const description =
	props.description ??
	props.frontmatter?.description ??
	'Under construction whenever my brain cells decide to cooperate.';


---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		{props.frontmatter?.jsonLd && (
			<script is:inline type="application/ld+json" set:html={props.frontmatter.jsonLd} />
		)}
	</head>
	<body>
		{props.frontmatter ? (
			<div class="md-content">
				<header class="md-header">
					<a class="wordmark" href="/">Lalitha A R</a>

				</header>
				<slot />
			</div>
		) : (
			<slot />
		)}
		<script is:inline>
			(() => {
				const refs = document.querySelectorAll('a[data-footnote-ref]');
				if (!refs.length) return;
				const wide = window.matchMedia('(min-width: 75rem)');
				for (const ref of refs) {
					ref.addEventListener('click', (event) => {
						if (!wide.matches) return;
						const number = (ref.getAttribute('href') || '').split('fn-').pop();
						const sidenote = document.getElementById(`sidenote-fn-${number}`);
						if (!sidenote) return;
						event.preventDefault();
						sidenote.scrollIntoView({ block: 'nearest' });
						sidenote.classList.remove('flash');
						void sidenote.offsetWidth;
						sidenote.classList.add('flash');
						clearTimeout(sidenote._flashTimer);
						sidenote._flashTimer = setTimeout(
							() => sidenote.classList.remove('flash'),
							1100,
						);
					});
				}
			})();
		</script>
	</body>

<style>
    :root {
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  color-scheme: light dark;
}

body {
  background-color: Canvas;
  color: CanvasText;


  max-width: 70ch;
  margin: 0 auto;
  padding: 2rem 1.25rem;
  line-height: 1.5;
}

header {
    font-size: 1.2rem;
    margin-bottom: 2.5rem;
    opacity: 0.7;
    > a {
        text-decoration: none;
        color: CanvasText;
        font-weight: 600;
    }
}

@media (prefers-color-scheme: dark) {
  body {
    background-color: #121212; 
    
    color: #e0e0e0; 
  }
}


p {
  margin-top: 0;
  margin-bottom: 1.25rem;

}


:global(blockquote) {
  margin: 1.5rem 0;
  padding-left: 1rem;
  border-left: 2px solid currentColor;
  opacity: 0.8;
  font-style: italic; /* optional */
}

:global(blockquote > p) {
  margin: 0;
}

:global(hr) {
  border: none;
  border-top: 1px solid currentColor;
  opacity: 0.2;
  margin: 2rem 0;
}

:global(a[data-footnote-ref]) {
  text-decoration: none;
  border-bottom: 1px dotted color-mix(in srgb, CanvasText 45%, transparent);
  border-radius: 2px;
}

:global(a[data-footnote-ref]:hover) {
  background: color-mix(in srgb, CanvasText 12%, transparent);
  border-bottom-color: CanvasText;
}

:global(.sidenote) {
  display: none;
}

@media (min-width: 75rem) {
  :global(body:has(.sidenote)) {
    max-width: calc(70ch + 32.5rem);
  }

  :global(.md-content:has(.sidenote)) {
    padding-inline-end: 30rem;
  }

  :global(.sidenote) {
    display: block;
    float: right;
    clear: right;
    width: 26rem;
    margin-right: -28rem;
    margin-top: 0.4rem;
    margin-bottom: 1rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: rgba(120, 120, 120, 0.92);
    color: color-mix(in srgb, CanvasText 78%, transparent);
  }

  :global(.sidenote p) {
    margin: 0 0 0.5em;
  }

  :global(.sidenote > p:last-child) {
    margin-bottom: 0;
  }

  :global(.sidenote.flash) {
    box-shadow: 0 0 0 3px color-mix(in srgb, CanvasText 30%, transparent);
  }

  :global(body:has(.sidenote) section[data-footnotes]) {
    display: none;
  }
}


</style>

</html>