---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		name: 'exam-turtle',
		description:
			'Free & open-source, spaced repetition app for topic-based learning, with exam-based priority built in.',
		href: 'https://github.com/lalithaar/exam-turtle',
		tag: 'HTML',
	},
	{
		name: 'learn-better',
		description: 'Learn like you are 5.',
		href: 'https://github.com/lalithaar/learn-better',
		tag: 'Vue',
	},
	{
		name: 'indian-exams-database',
		description: "Find the exam you didn't know existed (but probably should take).",
		href: 'https://github.com/lalithaar/indian-exams-database',
		tag: 'Database',
	},
	{
		name: 'cm-colors',
		description: 'You pick the colors. We make them readable.',
		href: 'https://github.com/lalithaar/cm-colors',
		tag: 'Python',
	},
	{
		name: 'ideabank',
		description: 'A list of ideas I thought of, free for anyone to use and implement from.',
		href: 'https://github.com/lalithaar/ideabank',
		tag: 'Python',
	},
	{
		name: 'safehome-blueprint',
		description:
			'An open design for a city-level home-services platform centered on dignity, safety, and trust.',
		href: 'https://github.com/lalithaar/safehome-blueprint',
		tag: 'Design',
	},
	{
		name: 'idea-protocol',
		description: 'Standard, plain-language licenses for sharing and discussing ideas without NDAs or awkwardness.',
		href: 'https://github.com/lalithaar/idea-protocol',
		tag: 'Docs',
	},
	{
		name: 'Interdisciplinary Systems Research Lab',
		description:
			'Open-research repository investigating systemic gaps in human-centric design — robomorphic robotics, psychophysical UI scaling, adversarial loops in food informatics.',
		href: 'https://github.com/lalithaar/Interdisciplinary-Systems-Research-Lab',
		tag: 'Research',
	},
];

const links = [
	{ label: 'GitHub', href: 'https://github.com/lalithaar' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/lalithaar/' },
	{ label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=dEiBWT8AAAAJ&hl=en' },
	{ label: 'ResearchGate', href: 'https://www.researchgate.net/profile/Lalitha-A-R' },
	{ label: 'ORCID', href: 'https://orcid.org/0009-0001-7466-3531' },
	{ label: 'iSRL Lab', href: 'https://isrl.in/' },
];
---

<Layout>
	<div id="container">
		<header>
			<span class="wordmark">Lalitha A R</span>
			<nav>
				{links.slice(0, 3).map((link) => (
					<a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
				))}
			</nav>
		</header>

		<main>
			<section id="hero">
				<p class="eyebrow">hi, i'm</p>
				<h1>Lalitha A R</h1>
				<p class="tagline">
					I find the exact interaction costing your product activation, retention, or support
					hours — then fix it. Research, code, design, copy, whatever the fix needs.
				</p>
				<p class="affiliation">
					Researcher at the <a href="https://isrl.in/" target="_blank" rel="noopener noreferrer"
						>Interdisciplinary Systems Research Lab (iSRL)</a
					>, studying BS Data Science at IIT Madras.
				</p>
				<div class="hero-links">
					{links.map((link) => (
						<a class="pill" href={link.href} target="_blank" rel="noopener noreferrer">
							{link.label}
						</a>
					))}
				</div>
			</section>

			<div class="divider" aria-hidden="true">&middot; &middot; &middot;</div>

			<section id="projects">
				<p class="eyebrow">things I've made</p>
				<h2>Projects &amp; research</h2>
				<div class="grid">
					{projects.map((project) => (
						<a class="card" href={project.href} target="_blank" rel="noopener noreferrer">
							<div class="card-head">
								<h3>{project.name}</h3>
								<span class="tag">{project.tag}</span>
							</div>
							<p>{project.description}</p>
						</a>
					))}
				</div>
			</section>
		</main>

		<footer>
			<p>Written from India &middot; <a href="mailto:lalithaar@isrl.in">lalithaar@isrl.in</a></p>
		</footer>
	</div>
</Layout>

<style>
	#container {
		max-width: 760px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 4rem;
	}

	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 0 3.5rem;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.wordmark {
		font-family: var(--font-serif);
		font-style: italic;
		color: var(--muted);
	}

	nav {
		display: flex;
		gap: 1.25rem;
	}

	nav a {
		text-decoration: none;
		color: var(--muted);
		font-size: 0.95rem;
	}

	nav a:hover {
		color: var(--accent);
	}

	.eyebrow {
		font-family: var(--font-serif);
		font-style: italic;
		color: var(--sage);
		margin: 0 0 0.25rem;
		font-size: 1.05rem;
	}

	#hero h1 {
		font-family: var(--font-serif);
		font-size: clamp(2.25rem, 6vw, 3.25rem);
		margin: 0 0 1.25rem;
		letter-spacing: -0.01em;
	}

	.tagline {
		font-size: 1.15rem;
		color: var(--ink);
		max-width: 58ch;
		margin: 0 0 1.1rem;
		line-height: 1.65;
	}

	.affiliation {
		color: var(--muted);
		max-width: 58ch;
		margin: 0 0 2rem;
	}

	.affiliation a {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-color: var(--accent-soft);
		text-underline-offset: 3px;
	}

	.affiliation a:hover {
		text-decoration-color: var(--accent);
	}

	.hero-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-bottom: 1rem;
	}

	.pill {
		border: 1px solid var(--border);
		background: var(--paper);
		border-radius: 999px;
		padding: 0.4rem 1rem;
		font-size: 0.9rem;
		text-decoration: none;
		color: var(--ink);
		transition: border-color 0.15s, color 0.15s, background 0.15s;
	}

	.pill:hover {
		border-color: var(--accent);
		color: var(--accent);
		background: var(--accent-soft);
	}

	.divider {
		text-align: center;
		color: var(--accent-soft);
		letter-spacing: 0.5em;
		margin: 3.5rem 0;
		font-size: 1.1rem;
	}

	#projects h2 {
		font-family: var(--font-serif);
		font-size: 1.6rem;
		margin: 0 0 1.75rem;
		font-weight: normal;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.1rem;
	}

	.card {
		display: block;
		background: var(--paper);
		border: 1px solid var(--border);
		border-radius: 18px;
		padding: 1.25rem 1.4rem;
		text-decoration: none;
		color: var(--ink);
		box-shadow: 0 1px 0 var(--border);
		transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
	}

	.card:hover {
		border-color: var(--accent-soft);
		transform: translateY(-2px) rotate(-0.2deg);
		box-shadow: 0 6px 16px -8px rgba(184, 98, 63, 0.35);
	}

	.card-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.card h3 {
		font-size: 1.05rem;
		margin: 0 0 0.5rem;
		font-weight: normal;
	}

	.tag {
		font-style: italic;
		font-size: 0.78rem;
		color: var(--sage);
		white-space: nowrap;
	}

	.card p {
		margin: 0;
		font-size: 0.93rem;
		color: var(--muted);
		line-height: 1.55;
	}

	footer {
		margin-top: 4rem;
		padding-top: 1.5rem;
		border-top: 1px dashed var(--border);
		color: var(--muted);
		font-size: 0.9rem;
		font-style: italic;
	}

	footer a {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-color: var(--accent-soft);
	}

	footer a:hover {
		text-decoration-color: var(--accent);
	}
</style>
