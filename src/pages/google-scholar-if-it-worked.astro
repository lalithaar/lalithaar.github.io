import { Image } from 'astro:assets';
import katex from 'katex';
// This page renders KaTeX maths inside abstracts, so it needs the layout that
// ships the katex stylesheet (Layout.astro deliberately does not). LayoutMath
// renders Wordmark/Pixel/Sidenotes itself, so the page does not.
import Layout from '../layouts/LayoutMath.astro';
import Wordmark from '../components/Wordmark.astro';
import WorkNotes from '../components/WorkNotes.astro';
import avatar from '../attachments/circle-logo.png';

const escapeHtml = (text: string) =>
	text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// Abstracts were pulled once from the Zenodo API (records' metadata.description)
// and hardcoded here, so the build still never touches the network. They are
// plain text with blank-line paragraph breaks: escape everything, turn single
// line breaks into <br>, and let KaTeX render any $...$ maths they contain.
function renderAbstract(abstract: string): string[] {
	return abstract
		.split(/\n{2,}/)
		.map((block) =>
			escapeHtml(block)
				.replace(/\n/g, '<br />')
				.replace(/\$([^$]+)\$/g, (_match, tex: string) =>
					katex.renderToString(tex, { throwOnError: false })
				)
		);
}

// Sidenotes. Astro never runs rehype-sidenotes.mjs (markdown pipeline only),
// so the two halves are written by hand: `ref(n)` is the reference anchor that
// hangs off a work below, and `notes` are the margin-note bodies, in the same
// order — ref(1) pairs with notes[0]. WorkNotes renders the matching ids,
// number links and backrefs, so only the numbering has to stay in sync.
const ref = (n: number) =>
	`<sup><a href="#user-content-fn-${n}" id="user-content-fnref-${n}" data-footnote-ref="" aria-describedby="footnote-label">${n}</a></sup>`;

const notes: string[] = [
	`While this preprint proposes two primary architectural interventions, I wish to provide a critical update regarding the first: tiered, implementation-focused documentation. Upon attempting to implement this documentation pre-release, I realized a fundamental flaw in its practical application. Unlike standard developer documentation that assists in the primary goal of learning a tool, this approach inadvertently raised a conflict of timing: was I writing a real-time implementation guide to be read before coding, or a guide for fixing code later? It became clear that it was primarily serving the latter. By focusing on \"how to fix\" or \"how to apply accessibility\" after the fact, the documentation merely reinforces the \"accessibility-as-an-add-on\" cycle that the Care Framework aims to break. This leads to a deeper systemic question: why do tutorials not teach accessibility as an intrinsic part of the primary language? Just as we learn type=\"email\" as a standard part of HTML forms, accessibility should be baked into the initial learning path of any framework. While I do not yet have a definitive answer on how to bridge that specific pedagogical gap, I believe the second intervention—framework-level accessible defaults—remains highly cascadable and impactful. I am sharing this work-in-progress to invite further dialogue on these evolving insights.`,
	`The library has 12k downloads as of 25-10-2026, along with a js version <a href="https://www.npmjs.com/package/cm-colors?activeTab=readme">https://www.npmjs.com/package/cm-colors?activeTab=readme</a> and supported the mechanism used by Inherent.css - Write plain HTML without adding a single class: get automatic light/dark mode, 1-token color branding, and responsive layouts out of the box.`,
	`The implementation proposed in this paper is to be considered BS, here's why - <a href="https://isrl.in/timeline/">See June 2025</a>. But the underlying principle: 'The complaince to make the web usable to people by what law mandates is the floor' still stands and is something I believe to this day.`,
	`This was inspired by, when I saw this robot cleaning a window glass the way humans do (a tremendous feat by the team!), that made me think but wouldn't there be a better and efficient way if this was designed in the form machines do it natively? (Instead of one hand holding the cloth, and sprayer in other)`,
];

