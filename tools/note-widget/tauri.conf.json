{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "note-widget",
  "version": "0.1.0",
  "identifier": "in.isrl.note-widget",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "note",
        "width": 470,
        "height": 500,
        "minWidth": 340,
        "minHeight": 320,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "center": false,
        "focus": false,
        "dragDropEnabled": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
